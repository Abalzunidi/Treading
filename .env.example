# انسخ هذا الملف إلى .env واملأ القيم. ملف .env لا يُرفع إلى git أبداً.

# --- MongoDB Atlas ---
# الطريقة 1 (الأسهل): اكتب كلمة السر كما هي، والخادم يرمّزها تلقائياً.
MONGODB_USER=abdalmajedalzunedi_db_user
MONGODB_PASSWORD=
MONGODB_HOST=cluster0.b7lt2hy.mongodb.net
MONGODB_DB=treading
# الطريقة 2: رابط كامل جاهز (يتجاوز الحقول أعلاه إن وُجد)
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.b7lt2hy.mongodb.net/?appName=Cluster0

# --- الخادم ---
PORT=3000
HOST=127.0.0.1
# رمز دخول للـ API (مطلوب إذا غيّرت HOST إلى 0.0.0.0 لفتح الخادم خارج جهازك)
API_TOKEN=

# --- استيراد ملف MetaTrader تلقائياً (يعمل لو الخادم على نفس جهاز المنصة) ---
# اتركه فارغاً لاستخدام المسار الافتراضي على ويندوز:
#   %APPDATA%\MetaQuotes\Terminal\Common\Files\trade_journal.csv
MT5_JOURNAL_CSV=
